while True:
    
    print("\n------ NEW ORDER -------")
    customer_name = input("Enter Customer Name: ")
    num_meals = int(input("Enter Number of Meals Ordered: "))
    price_per_meal = float(input("Enter Price per Meal (₱): "))
    
   
    total_amount = num_meals * price_per_meal
    
   
    if total_amount >= 500:
        discount = total_amount * 0.10
    else:
        discount = 0.0
        
    final_amount = total_amount - discount
    
  
    if num_meals >= 5 and final_amount >= 400:
        drink_status = "Qualified for Free Drink"
    else:
        drink_status = "Not Qualified"
        
    
    print("\n---------- FINAL BILL ---------")
    print(f"Customer Name: {customer_name}")
    print(f"Total Meals: {num_meals}")
    print(f"Price per Meal: ₱{price_per_meal:.2f}")
    print(f"Initial Total: ₱{total_amount:.2f}")
    print(f"Discount Applied: ₱{discount:.2f}")
    print(f"Final Amount Due: ₱{final_amount:.2f}")
    print(f"Free Drink Status: {drink_status}")
    print("--------------------------------")
  

    choice = input("\nDo you want to process another order? (Enter 'N' to stop, any other key to continue): ")
    if choice.strip().upper() == 'N':
        print("\nThank you for using the Cafeteria Billing System. Goodbye!")
        break
