

class Node:
    """A class representing an individual node in the linked list."""
    def __init__(self, data):
        self.data = data
        self.next = None


class Stack:
    """A class representing the stack using a linked list structure."""
    def __init__(self):
        self.top = None  
      
    def is_empty(self):
        """Checks if the stack is completely empty."""
        return self.top is None

    def push(self, data):
        """Adds a new element to the top of the stack."""
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        print(f"Successfully pushed '{data}' onto the stack.")

    def pop(self):
        """Removes and returns the top element from the stack."""
        if self.is_empty():
            print("Stack Underflow! The stack is empty, nothing to pop.")
            return None
        
        popped_node = self.top
        self.top = self.top.next
        print(f"Successfully popped '{popped_node.data}' from the stack.")
        return popped_node.data

    def peek(self):
        """Returns the top element of the stack without removing it."""
        if self.is_empty():
            print("The stack is empty. No element at the top.")
            return None
        return self.top.data

    def display(self):
        """Displays all elements in the stack from top to bottom."""
        if self.is_empty():
            print("The stack is empty.")
            return

        print("Stack elements (Top -> Bottom):")
        current = self.top
        while current is not None:
            if current.next is not None:
                print(f"| {current.data} | -> ", end="")
            else:
                print(f"| {current.data} |")
            current = current.next


def main():
    """Main function handling the menu-driven application loop."""
    stack = Stack()

    while True:
        print("\n========================================")
        print("        STACK USING LINKED LIST         ")
        print("========================================")
        print("1. Push")
        print("2. Pop")
        print("3. Peek")
        print("4. Display")
        print("5. Check if Empty")
        print("6. Exit")
        print("========================================")

        choice = input("Enter your choice (1-6): ").strip()

        if choice == '1':
            item = input("Enter the data to push: ")
            stack.push(item)
        
        elif choice == '2':
            stack.pop()
        
        elif choice == '3':
            top_item = stack.peek()
            if top_item is not None:
                print(f"Top element is: {top_item}")
        
        elif choice == '4':
            stack.display()
        
        elif choice == '5':
            if stack.is_empty():
                print("Yes, the stack is currently empty.")
            else:
                print("No, the stack is not empty.")
        
        elif choice == '6':
            print("Exiting the program. Goodbye!")
            break
        
        else:
            print("Invalid choice! Please select a valid option from 1 to 6.")


if __name__ == "__main__":
    main()
