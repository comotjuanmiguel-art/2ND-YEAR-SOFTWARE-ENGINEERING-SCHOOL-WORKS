# Activity 3

raw_order = " oRdEr_ID: #89421-phillipines | CuStOmEr: 'sArAh cOnNoR' | iTeM: \"wireless mechanical keyboard\" | pRiCe: $149.9982 | StAtUs: PENDING "

cleaned_order = raw_order.strip()
parts = [part.strip() for part in cleaned_order.split("|")]


order_id_part = parts[0].split(":")[1].strip()


order_code = order_id_part.split("-")[0].replace("#", "")
raw_country = order_id_part.split("-")[1]


country_code = "PH" if raw_country.lower() == "phillipines" else raw_country.upper()

customer_part = parts[1].split(":")[1].strip()
customer_name = customer_part.replace("'", "").title()

item_part = parts[2].split(":")[1].strip()
item_name = item_part.replace('"', "").title()

price_part = parts[3].split(":")[1].strip()
price_value = float(price_part.replace("$", ""))
formatted_price = round(price_value, 2)


status_part = parts[4].split(":")[1].strip()
status_name = status_part.title()

summary_report = (
    f"ORDER SUMMARY:\n"
    f"\tOrder ID:\t{order_code} (Country: {country_code})\n"
    f"\tCustomer:\t{customer_name}\n"
    f"\tPurchased:\t\t{item_name}\n"
    f"\tTotal paid:\t\t${formatted_price:.2f}\n"
    f"\tStatus:\t\t{status_name}")

print(summary_report)

