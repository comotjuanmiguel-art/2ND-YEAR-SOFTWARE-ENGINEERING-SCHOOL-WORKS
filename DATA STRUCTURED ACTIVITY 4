print("===SINGLY LINKED LIST===")
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None
        
    def insert(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
            return
        current = self.head
        while current.next is not None:
            current = current.next
        current.next = new_node
        
    def display(self):
        # Start at the first node
        current = self.head
        if current is None:
            print("The list is empty.")
            return
        while current is not None:
            print(current.data, end=" -> ")
            current = current.next
        print("None")
        
    def search(self, value):
        # Start at the first node
        current = self.head
        while current is not None:
            if current.data == value:
                return True
            current = current.next
        return False
        
    def delete(self, value):
        current = self.head
        previous = None
        while current is not None:
            if current.data == value:
                if previous is None:
                    self.head = current.next
                else:
                    previous.next = current.next
                print(value, "has been deleted.")
                return
            previous = current
            current = current.next
        print(value, "was not found.")

mylist = LinkedList()
mylist.insert("Quiz")
mylist.insert("Laboratory_Exercise")
mylist.insert("Midterm_Examination")
mylist.insert("Presentation")
mylist.insert(None)


print("\nOriginal Activities:")
mylist.display()

print("\nSearching for project:")
project = "Quiz"
if mylist.search(project):
    print(project, "was found.")
else:
    print(project, "was not found.")

project = "Presentation"
if mylist.search(project):
    print(project, "was found.")
else:
    print(project, "was not found.")

print("\nSearching for Final examination:")
mylist.delete("Final examination")


print("\nLinked List after deleting Midterm_Examination")

mylist.delete("Midterm_Examination")

print("\nUpdated Activities:")
mylist.display()

#DOUBLE!!!

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
        self.previous = None

class DoublyLinkedList:
    def __init__(self):
        self.head = None

    def insert(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
            return
        current = self.head
        while current.next is not None:
            current = current.next
        current.next = new_node
        new_node.previous = current

    def display_forward(self):
        current = self.head
        if current is None:
            print("The list is empty.")
            return
        while current is not None:
            print(current.data, end=" -> ")
            current = current.next
        print("None")

    def display_backward(self):
        current = self.head
        if current is None:
            print("The list is empty.")
            return
     
        while current.next is not None:
            current = current.next
       
        while current is not None:
            print(current.data, end=" <->")
            current = current.previous
        print("None")

    def search(self, value):
        current = self.head
        while current is not None:
            if current.data == value:
                return True
            current = current.next
        return False

    def delete(self, value):
        current = self.head
        while current is not None:
            if current.data == value:
                if current.previous is None:
                    self.head = current.next
                    if self.head is not None:
                        self.head.previous = None
                elif current.next is None:
                    current.previous.next = None
                else:
                    current.previous.next = current.next
                    current.next.previous = current.previous
                print(value, "has been deleted.")
                return
            current = current.next
        print(value, "was not found.")


mylist = DoublyLinkedList()
mylist.insert("Quiz")
mylist.insert("Laboratory_Exercise")
mylist.insert("Midterm_Examination")
mylist.insert("Presentation")
mylist.insert(None)

print("\nForward Linked List:")
mylist.display_forward()

print("\nSearching for project:")
